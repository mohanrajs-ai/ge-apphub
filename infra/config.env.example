# ==============================================================================
# Gemini Enterprise App Deployment Automation — Customer Configuration
# ==============================================================================
# Copy this file to `config.env` and customize the values for your target
# Google Cloud customer environment before running `./deploy.sh`.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Core Google Cloud Project & State Configuration
# ------------------------------------------------------------------------------
# Target Google Cloud Project ID where Gemini Enterprise will be deployed.
GCP_PROJECT_ID="customer-ge-prod-001"

# Default Google Cloud compute/storage region (e.g., us-central1, europe-west1).
GCP_REGION="us-central1"

# Gemini Enterprise / Discovery Engine multi-region location.
# Allowed values: "global", "us", "eu"
GE_LOCATION="global"

# Discovery Engine Collection ID (defaults to "default_collection").
GE_COLLECTION_ID="default_collection"

# Optional: Google Cloud Storage bucket name for remote Terraform state.
# Leave empty ("") to use local Terraform state (`terraform/terraform.tfstate`).
TF_STATE_BUCKET=""

# Optional: Prefix path inside TF_STATE_BUCKET for Terraform state.
TF_STATE_PREFIX="gemini-enterprise/state"

# ------------------------------------------------------------------------------
# 2. Gemini Enterprise App / Engine Configuration
# ------------------------------------------------------------------------------
# Unique identifier for the Gemini Enterprise App / Engine (lowercase, hyphens).
GE_APP_ID="enterprise-assistant-app"

# Human-readable display name shown in the Google Cloud Console and web app.
GE_APP_DISPLAY_NAME="Customer Gemini Enterprise Assistant"

# Organization or company name used to ground the assistant persona.
GE_COMPANY_NAME="Example Corp"

# Solution type for the engine.
# Allowed values: "SOLUTION_TYPE_SEARCH", "SOLUTION_TYPE_CHAT"
GE_SOLUTION_TYPE="SOLUTION_TYPE_SEARCH"

# Search tier for Gemini Enterprise features.
# Allowed values: "SEARCH_TIER_STANDARD", "SEARCH_TIER_ENTERPRISE"
GE_SEARCH_TIER="SEARCH_TIER_ENTERPRISE"

# Enable LLM / Generative answers add-on ("true" or "false").
GE_ENABLE_LLM_ADDON="true"

# Industry vertical for the Data Store and Engine.
# Allowed values: "GENERIC", "MEDIA", "HEALTHCARE_FHIR"
GE_INDUSTRY_VERTICAL="GENERIC"

# Default assistant ID under the Gemini Enterprise engine.
GE_ASSISTANT_ID="default_assistant"

# Additional system instruction / grounding prompt for the default assistant.
GE_ASSISTANT_SYSTEM_INSTRUCTION="You are a helpful enterprise assistant. Always ground your answers in verified company data stores."

# ------------------------------------------------------------------------------
# 3. Data Store & Backing Source Configuration
# ------------------------------------------------------------------------------
# Unique identifier for the primary Discovery Engine Data Store.
GE_DATA_STORE_ID="enterprise-knowledge-ds"

# Display name for the primary Data Store.
GE_DATA_STORE_DISPLAY_NAME="Enterprise Knowledge Base"

# Content config for the Data Store.
# Allowed values: "CONTENT_REQUIRED", "NO_CONTENT", "PUBLIC_WEBSITE"
GE_DATA_STORE_CONTENT_CONFIG="CONTENT_REQUIRED"

# Backing storage type to provision via Terraform ("GCS", "BIGQUERY", or "NONE").
GE_BACKING_STORAGE_TYPE="GCS"

# Name of the GCS bucket to provision (or reference) for unstructured docs.
GE_GCS_BUCKET_NAME="customer-ge-prod-001-ge-docs"

# Name of the BigQuery dataset to provision if GE_BACKING_STORAGE_TYPE="BIGQUERY".
GE_BQ_DATASET_ID="gemini_enterprise_data"

# ------------------------------------------------------------------------------
# 4. Identity, Access Control (ACLs) & IAM Principals
# ------------------------------------------------------------------------------
# Identity provider type for Discovery Engine ACLs.
# Allowed values: "GSUITE" (Google Workspace / Cloud Identity), "THIRD_PARTY" (Workforce Identity)
GE_IDENTITY_PROVIDER_TYPE="GSUITE"

# Workforce Identity Pool name (required only if GE_IDENTITY_PROVIDER_TYPE="THIRD_PARTY").
# Format: "locations/global/workforcePools/<pool-id>"
GE_WORKFORCE_IDENTITY_POOL=""

# Comma-separated IAM principals to grant Discovery Engine Viewer / User access.
# Example: "group:employees@example.com,user:admin@example.com"
GE_IAM_VIEWER_MEMBERS="user:admin@example.com"

# Customer Google Workspace / Cloud Identity primary domain for per-app group creation.
GE_CUSTOMER_DOMAIN="example.com"

# Optional Cloud Identity customer resource ID (e.g., "customers/C01234567").
# Leave empty ("") to auto-discover via Cloud Resource Manager organizations:search.
GE_CLOUD_IDENTITY_CUSTOMER_ID=""

# Dedicated Cloud Identity group email that grants exclusive access to this Gemini Enterprise App.
# Leave empty ("") to automatically derive "<GE_APP_ID>-users@<GE_CUSTOMER_DOMAIN>".
GE_APP_ACCESS_GROUP=""

# Comma-separated user email addresses to add as members of this app's dedicated access group.
GE_APP_GROUP_MEMBERS="admin@example.com"

# ------------------------------------------------------------------------------
# 5. Custom / ADK Agent Registration (via REST API / curl)
# ------------------------------------------------------------------------------
# Set to "true" to register an ADK / Vertex AI Agent Engine with Gemini Enterprise.
ENABLE_AGENT_REGISTRATION="false"

# Unique identifier for the registered agent within Gemini Enterprise.
AGENT_ID="ops-automation-agent"

# Display name for the registered agent in the Gemini Enterprise UI.
AGENT_DISPLAY_NAME="Operations & Support Agent"

# Description explaining when Gemini Enterprise should route queries to this agent.
AGENT_DESCRIPTION="Handles operational runbooks, ticket lookups, and deployment inquiries."

# Target Vertex AI Reasoning Engine resource name or A2A endpoint URL.
# Example: "projects/123456789012/locations/us-central1/reasoningEngines/987654321"
AGENT_REASONING_ENGINE="projects/customer-ge-prod-001/locations/us-central1/reasoningEngines/111222333444"
