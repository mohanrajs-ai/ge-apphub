# ==============================================================================
# Common Enterprise Data Connectors Registry
# ==============================================================================
# Copy this file to `configs/common_connectors.env` to automatically attach
# shared M365 connector Data Stores to every Gemini Enterprise App deployed
# via `./deploy.sh`.
# ==============================================================================

# Set to "true" to attach common connectors to all Gemini Enterprise apps by default
GE_ENABLE_COMMON_CONNECTORS="true"

# Comma-separated list of Discovery Engine Connector Collection IDs
GE_COMMON_CONNECTOR_COLLECTIONS="m365-sp,m365-od,m365-ol,m365-teams"

# Comma-separated list of child entity Data Store IDs across those collections
GE_COMMON_CONNECTOR_DATA_STORE_IDS="m365-sp_file,m365-sp_page,m365-od_file,m365-ol_mail,m365-ol_mail-attachment,m365-ol_calendar,m365-ol_contact,m365-teams_channel-message,m365-teams_chat-message"
