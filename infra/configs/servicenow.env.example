# ==============================================================================
# ServiceNow ITSM & Knowledge Connector — Configuration Template
# ==============================================================================
# Copy this file to `configs/<customer>-servicenow.env` (or let
# `./deploy_servicenow_bootstrap.sh` generate it automatically) and run:
#   ./deploy_servicenow.sh --config ./configs/cymbal-servicenow.env
# ==============================================================================

GCP_PROJECT_ID="customer-ge-prod-001"
GCP_REGION="us-central1"
GE_LOCATION="global"
TF_STATE_BUCKET="customer-ge-tfstate"
TF_STATE_PREFIX="ge-apphub/03b-servicenow-connector/sn-global-cymbal-servicenow"

# Secret Manager secret storing JSON:
#   {"instance_uri":"...","client_id":"...","client_secret":"...","username":"...","password":"..."}
SERVICENOW_SECRET_ID="cymbal-servicenow-connector-credentials"

SERVICENOW_COLLECTION_ID="cymbal-servicenow"
SERVICENOW_COLLECTION_DISPLAY_NAME="ServiceNow ITSM & Knowledge (cymbal)"
SERVICENOW_INSTANCE_URI="https://dev123456.service-now.com"
SERVICENOW_CONNECTOR_MODE="DATA_INGESTION"
SERVICENOW_REFRESH_INTERVAL="86400s"
SERVICENOW_ENTITIES="knowledge_base,incident,catalog_item"

ENABLE_SERVICENOW_ACTIONS="true"
SERVICENOW_ENABLED_ACTIONS="create_incident,update_incident,get_incident,add_comment_to_incident"

# Optional comma-separated list of Gemini Enterprise App IDs to attach ServiceNow entity Data Stores to
SERVICENOW_TARGET_APPS="cymbal-service-desk-app,cymbal-dev-sandbox-app"

# Optional environment overrides (loaded from Secret Manager if omitted):
SERVICENOW_CLIENT_ID="${SERVICENOW_CLIENT_ID:-}"
SERVICENOW_CLIENT_SECRET="${SERVICENOW_CLIENT_SECRET:-}"
SERVICENOW_USERNAME="${SERVICENOW_USERNAME:-}"
SERVICENOW_PASSWORD="${SERVICENOW_PASSWORD:-}"
