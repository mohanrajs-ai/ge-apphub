# ==============================================================================
# Gemini Enterprise App — Master 16-Point Enterprise Configuration Template
# ==============================================================================
# Rendered automatically by `./create_app_from_template.sh` to create isolated
# departmental Gemini Enterprise Apps (e.g., cymbal-finance-app, cymbal-hr-app,
# cymbal-service-desk-app, cymbal-dev-sandbox-app) with full enterprise controls.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Core Project, Location & Per-App Terraform Workspace State
# ------------------------------------------------------------------------------
GCP_PROJECT_ID="{{GCP_PROJECT_ID}}"
GCP_REGION="{{GCP_REGION}}"
GE_LOCATION="{{GE_LOCATION}}"
GE_COLLECTION_ID="default_collection"

TF_STATE_BUCKET="{{TF_STATE_BUCKET}}"
TF_STATE_PREFIX="ge-apphub/02-ge-app-instance/app-{{GE_LOCATION}}-{{GE_APP_ID}}"

# ------------------------------------------------------------------------------
# 2. App Core Configuration (No Per-App Knowledge Sources; Shared Connectors + Google Search Only)
# ------------------------------------------------------------------------------
GE_APP_ID="{{GE_APP_ID}}"
GE_APP_DISPLAY_NAME="{{GE_APP_DISPLAY_NAME}}"
GE_COMPANY_NAME="{{CUSTOMER_COMPANY_NAME}}"
GE_SOLUTION_TYPE="SOLUTION_TYPE_SEARCH"
GE_APP_TYPE="APP_TYPE_INTRANET"
GE_SEARCH_TIER="SEARCH_TIER_ENTERPRISE"
GE_ENABLE_LLM_ADDON="true"
GE_INDUSTRY_VERTICAL="GENERIC"

# Per-App Custom Knowledge Sources Disabled (Shared Connectors + Google Search Only)
GE_CREATE_PER_APP_DATA_STORE="false"
GE_DATA_STORE_ID=""
GE_DATA_STORE_DISPLAY_NAME=""
GE_DATA_STORE_CONTENT_CONFIG="NO_CONTENT"
GE_BACKING_STORAGE_TYPE="NONE"
GE_GCS_BUCKET_NAME=""
GE_BQ_DATASET_ID=""

# ------------------------------------------------------------------------------
# 3. Identity Configuration for App (Per-App Cloud Identity Group & ACLs)
# ------------------------------------------------------------------------------
GE_IDENTITY_PROVIDER_TYPE="GSUITE"
GE_WORKFORCE_IDENTITY_POOL=""
GE_CUSTOMER_DOMAIN="{{CUSTOMER_DOMAIN}}"
GE_CLOUD_IDENTITY_CUSTOMER_ID="{{CLOUD_IDENTITY_CUSTOMER_ID}}"
GE_APP_ACCESS_GROUP="{{GE_APP_ACCESS_GROUP}}"
GE_APP_GROUP_MEMBERS="admin@{{CUSTOMER_DOMAIN}}"
GE_IAM_VIEWER_MEMBERS="group:{{GE_APP_ACCESS_GROUP}}"

# ------------------------------------------------------------------------------
# 4. Associate Shared Enterprise Connectors (M365 SharePoint, OneDrive, Outlook, Teams)
# ------------------------------------------------------------------------------
GE_ENABLE_COMMON_CONNECTORS="true"
GE_COMMON_CONNECTOR_COLLECTIONS="{{CUSTOMER_NAME}}-m365-sp,{{CUSTOMER_NAME}}-m365-od,{{CUSTOMER_NAME}}-m365-ol,{{CUSTOMER_NAME}}-m365-teams"
GE_COMMON_CONNECTOR_DATA_STORE_IDS="{{CUSTOMER_NAME}}-m365-sp_file,{{CUSTOMER_NAME}}-m365-sp_page,{{CUSTOMER_NAME}}-m365-od_file,{{CUSTOMER_NAME}}-m365-ol_mail,{{CUSTOMER_NAME}}-m365-ol_mail-attachment,{{CUSTOMER_NAME}}-m365-ol_calendar,{{CUSTOMER_NAME}}-m365-ol_contact,{{CUSTOMER_NAME}}-m365-teams_channel-message,{{CUSTOMER_NAME}}-m365-teams_chat-message"

# ------------------------------------------------------------------------------
# 5. Admin-Configured Display Names for Connectors & Entity Data Stores
# ------------------------------------------------------------------------------
GE_CONNECTOR_DISPLAY_NAMES_JSON='{
  "{{CUSTOMER_NAME}}-m365-sp": {
    "collectionDisplayName": "{{CUSTOMER_COMPANY_NAME}} SharePoint Online",
    "entities": {
      "{{CUSTOMER_NAME}}-m365-sp_file": "SharePoint Documents",
      "{{CUSTOMER_NAME}}-m365-sp_page": "SharePoint Intranet Pages"
    }
  },
  "{{CUSTOMER_NAME}}-m365-od": {
    "collectionDisplayName": "{{CUSTOMER_COMPANY_NAME}} OneDrive",
    "entities": {
      "{{CUSTOMER_NAME}}-m365-od_file": "OneDrive Personal & Shared Files"
    }
  },
  "{{CUSTOMER_NAME}}-m365-ol": {
    "collectionDisplayName": "{{CUSTOMER_COMPANY_NAME}} Outlook Mail & Calendar",
    "entities": {
      "{{CUSTOMER_NAME}}-m365-ol_mail": "Outlook Emails",
      "{{CUSTOMER_NAME}}-m365-ol_mail-attachment": "Email Attachments",
      "{{CUSTOMER_NAME}}-m365-ol_calendar": "Outlook Calendar Events",
      "{{CUSTOMER_NAME}}-m365-ol_contact": "Directory Contacts"
    }
  },
  "{{CUSTOMER_NAME}}-m365-teams": {
    "collectionDisplayName": "{{CUSTOMER_COMPANY_NAME}} Microsoft Teams",
    "entities": {
      "{{CUSTOMER_NAME}}-m365-teams_channel-message": "Teams Channel Messages",
      "{{CUSTOMER_NAME}}-m365-teams_chat-message": "Teams Direct & Group Chats"
    }
  }
}'

# ------------------------------------------------------------------------------
# 6. Autocomplete Configuration
# ------------------------------------------------------------------------------
GE_ENABLE_AUTOCOMPLETE="true"
GE_AUTOCOMPLETE_MATCHING_ORDER="SUGGESTION_MATCHING_ORDER_PREFIX"
GE_ENABLE_PEOPLE_SUGGESTION="true"
GE_ENABLE_RECENT_SEARCH="true"

# ------------------------------------------------------------------------------
# 7. Feedback Configuration
# ------------------------------------------------------------------------------
GE_ENABLE_FEEDBACK="true"
GE_FEEDBACK_ALLOW_DETAILED_COMMENT="true"
GE_FEEDBACK_CAPTURE_THUMBS_UP_DOWN="true"

# ------------------------------------------------------------------------------
# 8. User Event Collection Configuration
# ------------------------------------------------------------------------------
GE_ENABLE_USER_EVENT_COLLECTION="true"
GE_USER_EVENT_RETENTION_DAYS="365"
GE_ENABLE_SEARCH_PERSONALIZATION="true"

# ------------------------------------------------------------------------------
# 9. App Branding & Custom Logo
# ------------------------------------------------------------------------------
GE_APP_LOGO_URI="https://storage.googleapis.com/{{GCP_PROJECT_ID}}-assets/{{CUSTOMER_NAME}}-logo.png"
GE_APP_FAVICON_URI="https://storage.googleapis.com/{{GCP_PROJECT_ID}}-assets/{{CUSTOMER_NAME}}-favicon.ico"

# ------------------------------------------------------------------------------
# 10. LLM System Instructions & Assistant Persona
# ------------------------------------------------------------------------------
GE_ASSISTANT_ID="default_assistant"
GE_ASSISTANT_SYSTEM_INSTRUCTION="{{GE_ASSISTANT_SYSTEM_INSTRUCTION}}"

# ------------------------------------------------------------------------------
# 11. Google Web Search Grounding (Share Google Search Only; Disable Per-App Knowledge Source Addition)
# ------------------------------------------------------------------------------
GE_ENABLE_WEB_SEARCH_GROUNDING="true"
GE_WEB_GROUNDING_TYPE="WEB_GROUNDING_TYPE_GOOGLE_SEARCH"
GE_ALLOW_PER_APP_KNOWLEDGE_SOURCES="false"
GE_FEATURE_ADD_KNOWLEDGE_SOURCES="FEATURE_STATE_OFF"
GE_SHARED_GROUNDING_SOURCE="GOOGLE_SEARCH_ONLY"
GE_ALLOWED_GROUNDING_SOURCES="GOOGLE_SEARCH"

# ------------------------------------------------------------------------------
# 12. Model Armor (Prompt Injection, Jailbreak & DLP/SDP Protection)
# ------------------------------------------------------------------------------
GE_ENABLE_MODEL_ARMOR="true"
GE_MODEL_ARMOR_PROMPT_TEMPLATE="projects/{{GCP_PROJECT_ID}}/locations/{{GCP_REGION}}/templates/{{CUSTOMER_NAME}}-model-armor-prompt"
GE_MODEL_ARMOR_RESPONSE_TEMPLATE="projects/{{GCP_PROJECT_ID}}/locations/{{GCP_REGION}}/templates/{{CUSTOMER_NAME}}-model-armor-response"
GE_MODEL_ARMOR_FAILURE_MODE="FAIL_CLOSED"

# ------------------------------------------------------------------------------
# 13. Enterprise Knowledge Catalog
# ------------------------------------------------------------------------------
GE_ENABLE_KNOWLEDGE_CATALOG="true"
GE_KNOWLEDGE_CATALOG_TAXONOMY="{{CUSTOMER_NAME}}-enterprise-taxonomy"

# ------------------------------------------------------------------------------
# 14. Chat History Retention Policy
# ------------------------------------------------------------------------------
GE_CHAT_HISTORY_RETENTION_DAYS="90"
GE_CHAT_SESSION_TTL_SECONDS="7776000s"

# ------------------------------------------------------------------------------
# 15. Private Knowledge Graph (PKG)
# ------------------------------------------------------------------------------
GE_ENABLE_PRIVATE_KNOWLEDGE_GRAPH="true"
GE_PKG_ENTITY_EXTRACTION_TYPES="PERSON,ORGANIZATION,PROJECT,ACRONYM,TOPIC"

# ------------------------------------------------------------------------------
# 16. Full Feature Management & Sharing Governance Matrix (Engine & Widget)
# ------------------------------------------------------------------------------
GE_FEATURE_AGENT_GALLERY="FEATURE_STATE_ON"
GE_FEATURE_NO_CODE_AGENT_BUILDER="FEATURE_STATE_ON"
GE_FEATURE_AGENT_SHARING="FEATURE_STATE_OFF"
GE_FEATURE_SKILLS="FEATURE_STATE_ON"
GE_FEATURE_SKILL_SHARING="FEATURE_STATE_ON"
GE_FEATURE_SKILL_SHARING_ADMIN_APPROVAL="FEATURE_STATE_ON"
GE_FEATURE_PROJECTS="FEATURE_STATE_ON"
GE_FEATURE_PROMPT_GALLERY="FEATURE_STATE_ON"
GE_FEATURE_MODEL_SELECTOR="FEATURE_STATE_ON"
GE_FEATURE_NOTEBOOK_LM="FEATURE_STATE_ON"
GE_FEATURE_DEEP_RESEARCH="FEATURE_STATE_ON"
GE_FEATURE_PEOPLE_SEARCH="FEATURE_STATE_ON"
GE_FEATURE_ACTIONS="FEATURE_STATE_ON"
GE_FEATURE_AUDIO_OVERVIEW="FEATURE_STATE_ON"

# Agent Sharing (Disabled) + Skills & Admin-Approved Sharing + Projects (Enabled)
GE_ALLOW_AGENT_SHARING="false"
GE_AGENT_SHARING_POLICY="SHARING_POLICY_DISABLED"
GE_ENABLE_SKILLS="true"
GE_SKILL_SHARING_APPROVAL_POLICY="ADMIN_APPROVAL_REQUIRED"
GE_REQUIRE_ADMIN_APPROVAL_FOR_SKILL_SHARING="true"
GE_SKILL_APPROVER_GROUP="ge-platform-admins@{{CUSTOMER_DOMAIN}}"
GE_ENABLE_PROJECTS="true"

# ------------------------------------------------------------------------------
# 17. Observability, Audit Logging & BigQuery Analytics Export
# ------------------------------------------------------------------------------
GE_ENABLE_OBSERVABILITY="true"
GE_OBSERVABILITY_AUDIT_LOGGING="true"
GE_OBSERVABILITY_QUERY_RESPONSE_LOGGING="true"
GE_OBSERVABILITY_LATENCY_METRICS="true"
GE_OBSERVABILITY_BQ_DATASET="{{CUSTOMER_NAME}}_ge_observability"
GE_OBSERVABILITY_LOG_SINK_NAME="{{GE_APP_ID}}-audit-sink"

# ------------------------------------------------------------------------------
# 18. Optional Pinned Universal ADK Skill Orchestrator Registration
# ------------------------------------------------------------------------------
ENABLE_AGENT_REGISTRATION="false"
AGENT_ID="universal-skill-orchestrator"
AGENT_DISPLAY_NAME="{{CUSTOMER_COMPANY_NAME}} Enterprise Skill Orchestrator"
AGENT_DESCRIPTION="Executes governed {{CUSTOMER_COMPANY_NAME}} Parent Skills and Sub-Skills using your M365 & GE identity."
AGENT_REASONING_ENGINE=""
