# ==============================================================================
# Microsoft Entra ID to Google Cloud Identity Sync & SAML SSO — Configuration
# ==============================================================================
# Copy this file to `configs/identity.env` and populate your customer's
# Google Cloud Identity and Microsoft Entra ID parameters before running
# `./deploy_identity.sh --config configs/identity.env`.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Google Cloud & Cloud Identity Foundation
# ------------------------------------------------------------------------------
GCP_PROJECT_ID="customer-ge-prod-001"
GCP_REGION="us-central1"
GCP_ORG_ID="123456789012"
GE_LOCATION="global"

# Google Cloud Identity Customer ID & Corporate Domain
# (Find Customer ID in admin.google.com -> Account -> Account settings -> Profile)
CLOUD_IDENTITY_CUSTOMER_ID="customers/C01234567"
PRIMARY_CUSTOMER_DOMAIN="example.com"

# Shared Verified Domain across Microsoft Entra ID and Google Cloud Identity.
# In most production enterprises (e.g., techmahindra.com), this is identical to PRIMARY_CUSTOMER_DOMAIN.
SHARED_IDENTITY_DOMAIN="example.com"

# Optional initial Microsoft Entra ID domain (only used if ENTRA_BULK_UPDATE_UPN_DOMAIN="true")
ENTRA_SOURCE_DOMAIN="yourtenant.onmicrosoft.com"

# Optional Remote Terraform State Backend
TF_STATE_BUCKET=""
TF_STATE_PREFIX="gemini-enterprise/identity-sync"

# ------------------------------------------------------------------------------
# 2. Shared M365 Credentials (from Environment Variables & Secret Manager)
# ------------------------------------------------------------------------------
# Secret Manager secret storing JSON:
#   {"tenant_id":"...","client_id":"...","client_secret":"..."}
M365_SECRET_ID="m365-connector-credentials"

# M365 Entra ID credentials are read from environment variables (do not hardcode secrets in Git):
#   export M365_TENANT_ID="<your-entra-tenant-id>"
#   export M365_CLIENT_ID="<your-entra-app-client-id>"
#   export M365_CLIENT_SECRET="<your-entra-app-client-secret>"
M365_TENANT_ID="${M365_TENANT_ID:-}"
M365_CLIENT_ID="${M365_CLIENT_ID:-}"
M365_CLIENT_SECRET="${M365_CLIENT_SECRET:-}"

# ------------------------------------------------------------------------------
# 3. Optional Cloud DNS Shared Domain Verification
# ------------------------------------------------------------------------------
# Leave false if your corporate domain is already verified in Entra ID & Cloud Identity
MANAGE_DNS_VERIFICATION_RECORD="false"
DNS_PROJECT_ID=""
DNS_ZONE_NAME=""
ENTRA_DOMAIN_VERIFICATION_MS_ID=""
GOOGLE_DOMAIN_VERIFICATION_TXT=""

# ------------------------------------------------------------------------------
# 4. GCP Directory Sync (Managed Entra ID -> Cloud Identity Lifecycle)
# ------------------------------------------------------------------------------
# IDENTITY_SYNC_MODE:
#   - "GCP_DIRECTORY_SYNC" (Recommended Default): Native Google Cloud Identity
#     Directory Sync owns User, Group & Membership lifecycle; Terraform only
#     manages Per-App Group Nesting (ENTRA_TO_APP_GROUP_MAPPINGS) and DNS/SSO.
#   - "TERRAFORM_GRAPH" (Legacy): Scrapes Microsoft Graph into Terraform state.
IDENTITY_SYNC_MODE="GCP_DIRECTORY_SYNC"
ENABLE_GCP_DIRECTORY_SYNC="true"
DIRECTORY_SYNC_MANAGED_GROUPS="ge-service-desk-users,ge-finance-users,ge-hr-users,ge-skill-developers,all-ge-apps-users"
BOOTSTRAP_EMPTY_SYNC_GROUP_SHELLS="true"
AUTO_ASSIGN_GE_LICENSES_FROM_SYNCED_GROUPS="true"
ENABLE_ENTRA_SCIM_PROVISIONING_JOB="false"

# Leave false for production enterprises whose users already use @<SHARED_IDENTITY_DOMAIN>.
# Set to true only for sandbox tenants migrating users off @*.onmicrosoft.com.
ENTRA_BULK_UPDATE_UPN_DOMAIN="false"
ENTRA_UPN_REWRITE_EXCLUDE_USERS="admin@yourtenant.onmicrosoft.com"

# Whether to also provision/update user accounts in Google Cloud Identity via Admin SDK Directory API
SYNC_CLOUD_IDENTITY_USERS="false"
CLOUD_IDENTITY_DEFAULT_TEMP_PASSWORD="ChangeMe!Temp2026#"

# Optional: Create new dedicated Entra Security Groups from scratch (false by default for existing enterprise groups)
PROVISION_CLEAN_ENTRA_APP_GROUPS="false"
# Format when PROVISION_CLEAN_ENTRA_APP_GROUPS="true":
#   "groupNick1|Display Name 1|Description 1|user1,user2;groupNick2|Display Name 2|Description 2|user3,user4"
ENTRA_CLEAN_GROUPS_SPEC=""

# Optional OData filter when querying Microsoft Graph /v1.0/groups
# Example: "startswith(mailNickname,'ge-')" (leave empty to sync all security/M365 groups)
ENTRA_GROUP_FILTER="startswith(mailNickname,'ge-')"

# Comma-separated mappings from synced Entra Group email -> Gemini Enterprise Per-App Group email
# Format: "<entra-group-email>:<ge-app-group-email>,..."
# Example: "ge-finance-users@example.com:finance-app-01-users@example.com,ge-hr-users@example.com:hr-app-01-users@example.com"
ENTRA_TO_APP_GROUP_MAPPINGS=""

# ------------------------------------------------------------------------------
# 5. Cloud Identity Inbound SAML 2.0 SSO Profile (Entra ID Redirect)
# ------------------------------------------------------------------------------
# When true, automatically creates/verifies the Inbound SAML SSO Profile in Cloud Identity
# for Microsoft Entra ID and prints the SP Entity ID and ACS URL.
ENABLE_CLOUD_IDENTITY_SAML_SSO="true"
SAML_SSO_PROFILE_DISPLAY_NAME="Microsoft Entra ID SSO"

# Optional path to downloaded Entra ID Base64 Certificate (.cer) to auto-upload via API
SAML_IDP_CERT_FILE=""

# Optional Cloud Identity Org Unit (e.g., "orgUnits/03ph8a2z...") to auto-assign SAML_SSO mode
SAML_TARGET_ORG_UNIT=""

# Optional Workforce Identity Pool OIDC Federation (leave false when using Cloud Identity idpType=GSUITE)
ENABLE_WORKFORCE_POOL_OIDC="false"
WORKFORCE_POOL_ID="entra-id-shared-pool"
WORKFORCE_PROVIDER_ID="entra-id-oidc-provider"
