# ==============================================================================
# Master Customer Onboarding — Phase & Environment Configuration
# ==============================================================================
# Copy this file to `configs/<customer>-onboard.env` (e.g., `configs/cymbal-onboard.env`)
# and toggle individual phases (`true` or `false`) before running:
#   ./onboard_customer.sh --config ./configs/cymbal-onboard.env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Customer & Cloud Foundation Parameters
# ------------------------------------------------------------------------------
CUSTOMER_NAME="cymbal"
CUSTOMER_DOMAIN="example.com"
GCP_PROJECT_ID="customer-ge-prod-001"
GCP_REGION="us-central1"
ENTRA_TENANT_ID="00000000-0000-0000-0000-000000000000"
DNS_PROJECT_ID="customer-dns-project"
DNS_ZONE_NAME="customer-dns-zone"
ENTRA_MODE="terraform"

# Optional ServiceNow Parameters (used when Phase 0D / Phase 2B are enabled)
SERVICENOW_INSTANCE_URI="https://dev123456.service-now.com"
SERVICENOW_ADMIN_USER="admin"

# ------------------------------------------------------------------------------
# 2. Onboarding Phase Toggles ("true" = Execute Phase, "false" = Skip Phase)
# ------------------------------------------------------------------------------

# Phase 0C: Enable GCP APIs & Create Versioned Remote Terraform State Bucket (gs://<customer>-ge-tfstate)
ENABLE_PHASE_0C_GCP_FOUNDATION="true"

# Phase 0B: Google Admin Console Bootstrap, Domain DNS TXT Verification & SAML SSO Profile (deploy_google_admin_bootstrap.sh)
ENABLE_PHASE_0B_GOOGLE_ADMIN="true"

# Phase 0A: Microsoft Entra ID OAuth App + 49 M365/DirectorySync Permissions + SAML Gallery App (deploy_entra_bootstrap.sh)
ENABLE_PHASE_0A_ENTRA_BOOTSTRAP="true"

# Phase 0D: ServiceNow Instance Bootstrap — Integration User, ITSM/KB/Catalog Roles, OAuth 2.0 Client & Secret Manager Sync (deploy_servicenow_bootstrap.sh)
ENABLE_PHASE_0D_SERVICENOW_BOOTSTRAP="false"

# Phase 1A: GCP Directory Sync Connector Config, Group Reconciliation & GE License Sync (deploy_gcp_directory_sync.sh)
ENABLE_PHASE_1A_DIRECTORY_SYNC="true"

# Phase 1B: Cloud Identity Per-App Group Nesting & SAML Handshake via Terraform (deploy_identity.sh)
ENABLE_PHASE_1B_IDENTITY_TERRAFORM="true"

# Phase 1C: Optional Sandbox CSV Group Membership Seeding (sync_group_members_from_csv.sh — keep false in production)
ENABLE_PHASE_1C_DEMO_CSV_SEED="false"

# Phase 2: Shared M365 Connectors — SharePoint, OneDrive, Outlook, Teams (deploy_m365.sh)
ENABLE_PHASE_2_M365_CONNECTORS="true"

# Phase 2B: Shared ServiceNow Connector — Knowledge Base, Incidents, Catalog Items & BAP Actions (deploy_servicenow.sh)
ENABLE_PHASE_2B_SERVICENOW_CONNECTOR="false"

# Phase 3: Departmental Gemini Enterprise Apps — Dev Sandbox, Service Desk, Finance, HR (create_app_from_template.sh)
ENABLE_PHASE_3_GE_APPS="true"
# Optional comma-separated filter of App IDs to run in Phase 3 (leave empty to provision all 4 departmental apps):
# Example: PHASE_3_TARGET_APPS="cymbal-service-desk-app,cymbal-finance-app,cymbal-hr-app"
PHASE_3_TARGET_APPS=""

# Phase 4: Deploy & Pin Universal ADK Skill Orchestrator across Gemini Enterprise Apps (publish_universal_agent.sh)
ENABLE_PHASE_4_UNIVERSAL_AGENT="true"
# Set to "true" to also build & deploy a new Vertex AI ReasoningEngine revision via `agents-cli deploy`,
# or "false" to only register/pin/share the existing ReasoningEngine across all Gemini Enterprise Apps:
PHASE_4_DEPLOY_REASONING_ENGINE="true"

# Phase 5: 6-Rubric Benchmark Gate, GCS Catalog Upload & Multi-App Skill Sharing (publish_m365_skills.sh)
ENABLE_PHASE_5_SKILL_SHARING="true"
