# ==============================================================================
# Microsoft 365 (M365) Data Connectors — Customer Configuration
# ==============================================================================
# Copy this file to `configs/m365.env` and populate your Microsoft Entra ID
# and M365 tenant parameters before running `./deploy_m365.sh`.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Core Google Cloud Project & State Configuration
# ------------------------------------------------------------------------------
GCP_PROJECT_ID="customer-ge-prod-001"
GCP_REGION="us-central1"
GE_LOCATION="global"

# Optional GCS bucket for remote Terraform state (leave empty for local state)
TF_STATE_BUCKET=""
TF_STATE_PREFIX="gemini-enterprise/m365-connectors"

# Prefix for the Discovery Engine Collections created for each M365 connector
M365_COLLECTION_PREFIX="m365"

# Optional Gemini Enterprise App (Engine) ID to automatically attach M365 connector Data Stores to
GE_APP_ID=""

# ------------------------------------------------------------------------------
# 2. Microsoft Entra ID (Azure AD) Secret Manager & App Credentials
# ------------------------------------------------------------------------------
# Google Cloud Secret Manager Secret ID storing JSON {"tenant_id","client_id","client_secret"}
M365_SECRET_ID="m365-connector-credentials"

# M365 Entra ID credentials are read from environment variables (do not hardcode secrets in Git):
#   export M365_TENANT_ID="<your-entra-tenant-id>"
#   export M365_CLIENT_ID="<your-entra-app-client-id>"
#   export M365_CLIENT_SECRET="<your-entra-app-client-secret>"
M365_TENANT_ID="${M365_TENANT_ID:-}"
M365_CLIENT_ID="${M365_CLIENT_ID:-}"
M365_CLIENT_SECRET="${M365_CLIENT_SECRET:-}"

# Connector operating mode: "FEDERATED" or "DATA_INGESTION"
M365_CONNECTOR_MODE="FEDERATED"

# Full sync refresh interval (min 1800s / 30m, max 604800s / 7d)
M365_REFRESH_INTERVAL="86400s"

# Set to "true" to enable write/mutating Actions (BAP & Action Config) on M365 connectors
ENABLE_M365_ACTIONS="true"

# ------------------------------------------------------------------------------
# 3. Identity & ACL Configuration (Cloud Identity + Entra SAML SSO)
# ------------------------------------------------------------------------------
# Set to "true" to configure project/location ACL settings for M365
M365_CONFIGURE_ACL="false"
GE_IDENTITY_PROVIDER_TYPE="GSUITE"
GE_WORKFORCE_IDENTITY_POOL=""

# ------------------------------------------------------------------------------
# 4. M365 Connector Toggles, Entities & Write Actions
# ------------------------------------------------------------------------------
# --- Microsoft SharePoint Online ---
ENABLE_SHAREPOINT_CONNECTOR="true"
M365_SHAREPOINT_COLLECTION_ID="m365-sp"
M365_SHAREPOINT_DATA_SOURCE="sharepoint_federated_search"
M365_SHAREPOINT_CONNECTOR_MODE="FEDERATED"
M365_SHAREPOINT_INSTANCE_URI="https://yourtenant.sharepoint.com"
M365_SHAREPOINT_ENTITIES="file,page"
M365_SHAREPOINT_ENABLED_ACTIONS="create_folder,add_page,upload_document,add_list,list_lists,get_list_item,get_list_fields,check_in_document,check_out_document,discard_check_out_document,move_attachment_or_document,rename_attachment_or_document,update_file_properties,create_list_item,update_list_item,update_list,update_page,share_resource"

# --- Microsoft OneDrive ---
ENABLE_ONEDRIVE_CONNECTOR="true"
M365_ONEDRIVE_COLLECTION_ID="m365-od"
M365_ONEDRIVE_CONNECTOR_MODE="FEDERATED"
M365_ONEDRIVE_INSTANCE_URI="https://yourtenant-my.sharepoint.com"
M365_ONEDRIVE_ENTITIES="file"
M365_ONEDRIVE_ENABLED_ACTIONS="upload_file,copy_file,copy_folder,move_file,move_folder,create_folder,rename_file,rename_folder,share_file_folder,update_file_properties"

# --- Microsoft Outlook (Exchange Online) ---
ENABLE_OUTLOOK_CONNECTOR="true"
M365_OUTLOOK_COLLECTION_ID="m365-ol"
M365_OUTLOOK_CONNECTOR_MODE="FEDERATED"
M365_OUTLOOK_INSTANCE_URI="https://outlook.office365.com"
M365_OUTLOOK_ENTITIES="mail,mail-attachment,calendar,contact"
M365_OUTLOOK_ENABLED_ACTIONS="send_mail,create_message,update_message,reply_to_my_message,forward_mail,move_mail,add_attachments,download_attachments,create_event,update_event,rsvp_to_event,create_calendar,update_calendar,create_contact,update_contact"

# --- Microsoft Teams ---
ENABLE_TEAMS_CONNECTOR="true"
M365_TEAMS_COLLECTION_ID="m365-teams"
M365_TEAMS_CONNECTOR_MODE="FEDERATED"
M365_TEAMS_INSTANCE_URI="https://teams.microsoft.com"
M365_TEAMS_ENTITIES="channel-message,chat-message"
M365_TEAMS_ENABLED_ACTIONS="send_channel_message,send_chat_message,create_channel"
