  "industryVertical": "${GE_INDUSTRY_VERTICAL}",
  "dataStoreIds": [
    "${GE_DATA_STORE_ID}"
  ],
  "commonConfig": {
    "companyName": "${GE_COMPANY_NAME}"
  },
  "searchEngineConfig": {
    "searchTier": "${GE_SEARCH_TIER}",
    "searchAddOns": [
      "SEARCH_ADD_ON_LLM"
    ]
  },
  "features": {
    "agent-gallery": "${GE_FEATURE_AGENT_GALLERY}",
    "no-code-agent-builder": "${GE_FEATURE_NO_CODE_AGENT_BUILDER}",
    "agent-sharing": "${GE_FEATURE_AGENT_SHARING}",
    "add-knowledge-sources": "${GE_FEATURE_ADD_KNOWLEDGE_SOURCES}",
